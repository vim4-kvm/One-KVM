[Unit]
Description=One-KVM on VIM4
After=network.target vim4-kvm-hdmi.service vim4-kvm-gadget.service vim4-kvm-pd.service
Requires=vim4-kvm-hdmi.service vim4-kvm-gadget.service vim4-kvm-pd.service
Conflicts=nanokvm.service vim4-kvm.service vim4-pikvm.service

[Service]
User=khadas
Group=khadas
SupplementaryGroups=video input audio systemd-journal vim4-watchdog dialout
RuntimeDirectory=one-kvm
RuntimeDirectoryMode=0700
StateDirectory=one-kvm
StateDirectoryMode=0700
WorkingDirectory=/var/lib/one-kvm
Environment=GST_PLUGIN_PATH=/usr/lib/vim4-kvm/gstreamer-1.0
Environment=LD_LIBRARY_PATH=/opt/vim4-onekvm/lib
Environment=GST_REGISTRY=/var/lib/one-kvm/gstreamer-registry.bin
ExecStartPre=/usr/bin/test -r /opt/vim4-onekvm/lib/libgst-aml-dma-allocator.so
ExecStart=/usr/libexec/vim4-kvm-run onekvm
ExecStopPost=/usr/bin/sudo -n /usr/libexec/vim4-onekvm usb-restore
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
AmbientCapabilities=CAP_NET_BIND_SERVICE
# The vendor encoder lock is shared with NanoKVM and JetKVM.
PrivateTmp=false
UMask=0077

[Install]
WantedBy=multi-user.target
